# 复制为 .env 后填写。.env 不会进仓库。
# 留空的项等于没配：后端会忽略空值，不会拿它覆盖掉真实的环境变量。

# 在 https://www.opensubtitles.com 注册后，于 Profile -> API Consumers 生成。
# 没有 EXPO_PUBLIC_ 前缀，所以只留在后端进程里，不会被打进客户端 bundle。
# 字幕请求由后端转发（OpenSubtitles 会按 User-Agent 拦截浏览器）。
OPENSUBTITLES_API_KEY=

# 电影库根目录。后端扫这个目录形成片库，视频也从这里按 Range 串流出去。
# 字幕会存到视频文件旁边，顺带生成一份通用双语 srt，PotPlayer、VLC 之类的播放器也能直接加载。
# 留空则用项目下的 media/（会自动建出来），把视频拷进去再点「重新扫描」即可。
# 已经有整理好的电影收藏时才需要填这一项。
# 注意：扫出来的片子是公共的，所有用户都看得见；用户自己上传的才有归属。
MOVIE_ROOT=

# 后端监听端口，默认 4000。
FASTENGLISH_PORT=

# 注册邀请码。第一个账号随便建，之后就得凭它。
# 留空 = 有人之后彻底关闭注册（登录页上连注册入口都不出现）。
# 只在局域网里自己用的话留空最省心；一旦挂到公网（隧道、端口映射），
# 不配这一项等于让任何扫到地址的人开号、翻你共享的片子、往你硬盘传东西。
FASTENGLISH_INVITE_CODE=

# 听模式音轨的码率和声道数，默认 64k 单声道。
# 学口语这个档位够用，2 小时的片子约 60MB；想保留声场就填 96k / 2。
# 改完只影响之后新抽的音轨，已经抽好的要删掉 data/audio/ 里对应的文件才会重来。
FASTENGLISH_AUDIO_BITRATE=
FASTENGLISH_AUDIO_CHANNELS=

# 用户数据库存放目录，默认项目下的 data/。
# 里面有账号、所有人的学习记录、用户上传的片子（data/uploads/<用户 id>/），
# 以及听模式抽出来的音轨缓存（data/audio/）。
# 换机器时把这个目录整个拷走就完成了迁移。上传功能会吃掉不少磁盘，
# 想放到大盘上就改这里。
FASTENGLISH_DATA_DIR=

# 前端要连的后端地址。不填会自己猜：
#   网页端用当前主机名换 4000 端口；原生端用 Expo 报的开发机 IP 换 4000 端口。
# 手机连的是局域网，所以这里不能写 localhost——那指向手机自己。
# 部署到别的机器或换了端口时才需要显式填，例如 http://192.168.1.5:4000
EXPO_PUBLIC_API_BASE=
